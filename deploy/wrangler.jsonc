{
  "name": "air-stats-download",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-13",
  "workers_dev": false,
  // health.aidaniil.com is the published home. health.sparkles.dev stays bound because
  // copies of Air Stats released before the move still ask it for updates.
  "routes": [
    { "pattern": "health.aidaniil.com", "custom_domain": true },
    { "pattern": "health.sparkles.dev", "custom_domain": true }
  ],
  // Counts downloads and daily update checks. No request bodies, addresses, or
  // health data are recorded; see the install counting notes in README.md.
  "analytics_engine_datasets": [
    { "binding": "USAGE", "dataset": "air_stats_usage" }
  ]
}
